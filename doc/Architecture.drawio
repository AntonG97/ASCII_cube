<mxfile host="app.diagrams.net" modified="2026-10-08T20:55:00.000Z" agent="Copilot" version="24.7.17" type="device">
  <diagram id="ascii-cube-architecture" name="Architecture">
    <mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="ASCII Cube — current C++ architecture" style="text;html=1;align=center;verticalAlign=middle;fontSize=24;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="550" y="10" width="700" height="40" as="geometry" />
        </mxCell>
        <mxCell id="main" value="&lt;b&gt;main.cpp&lt;/b&gt;&lt;br&gt;Creates the selected Shape, CLIpc and Renderer&lt;br&gt;Runs render / input / 18.5 ms frame-delay loop&lt;br&gt;Handles SIGINT and exits cleanly" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="700" y="70" width="400" height="125" as="geometry" />
        </mxCell>
        <mxCell id="cli" value="&lt;b&gt;CLI_Parser&lt;/b&gt;&lt;br&gt;&lt;b&gt;ArgParser&lt;/b&gt; validates Shape / Scale / Color arguments&lt;br&gt;&lt;b&gt;ShapeFactory&lt;/b&gt; creates Cube, Octahedron or Tetrahedron; Random chooses one&lt;br&gt;Returns the Shape to main" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="90" y="270" width="470" height="160" as="geometry" />
        </mxCell>
        <mxCell id="input" value="&lt;b&gt;InputParser&lt;/b&gt; (namespace)&lt;br&gt;Polls stdin without blocking the frame loop&lt;br&gt;Recognizes q / clear as exit commands" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="90" y="540" width="470" height="115" as="geometry" />
        </mxCell>
        <mxCell id="shapes" value="&lt;b&gt;Shape&lt;/b&gt; interface&lt;br&gt;Provides mutable vertices and const faces&lt;br&gt;&lt;br&gt;&lt;b&gt;Concrete shapes&lt;/b&gt;&lt;br&gt;Cube · Octahedron · Tetrahedron&lt;br&gt;Each shape defines its vertices and triangular faces" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="90" y="780" width="470" height="180" as="geometry" />
        </mxCell>
        <mxCell id="renderer" value="&lt;b&gt;Renderer&lt;/b&gt;&lt;br&gt;Holds a Shape reference, Transformation and Rasterizer&lt;br&gt;Coordinates each frame:&lt;br&gt;transform vertices → rasterize faces" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="700" y="290" width="400" height="145" as="geometry" />
        </mxCell>
        <mxCell id="transformation" value="&lt;b&gt;Transformation&lt;/b&gt;&lt;br&gt;&lt;b&gt;Rotation&lt;/b&gt; applies the animated rotation to original vertices&lt;br&gt;&lt;b&gt;Projection&lt;/b&gt; applies perspective projection&lt;br&gt;Updates the Shape's vertices for the frame" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="700" y="545" width="400" height="155" as="geometry" />
        </mxCell>
        <mxCell id="rasterizer" value="&lt;b&gt;Rasterizer&lt;/b&gt;&lt;br&gt;Groups coplanar faces for shared glyphs&lt;br&gt;Uses face normals / dot product for visibility&lt;br&gt;Scanline-fills triangles; depth-tests pixels&lt;br&gt;Writes pixels to FrameBuffer and sends rows to IDisplay" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1260" y="285" width="460" height="190" as="geometry" />
        </mxCell>
        <mxCell id="display" value="&lt;b&gt;IDisplay&lt;/b&gt; interface&lt;br&gt;Pixel, row-buffer, clear and dimensions operations&lt;br&gt;&lt;br&gt;&lt;b&gt;CLIpc&lt;/b&gt; implements IDisplay&lt;br&gt;Writes the terminal frame with ANSI controls / colors&lt;br&gt;Restores cursor and terminal color on destruction" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce5cd;strokeColor=#d79b00;fontSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1260" y="565" width="460" height="190" as="geometry" />
        </mxCell>
        <mxCell id="buffer" value="&lt;b&gt;FrameBuffer&lt;/b&gt;&lt;br&gt;Stores the frame's character pixels only&lt;br&gt;Provides row iteration via RowView / Iterator&lt;br&gt;Depth buffer belongs to Rasterizer, not FrameBuffer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1260" y="845" width="460" height="135" as="geometry" />
        </mxCell>
        <mxCell id="util" value="&lt;b&gt;Util&lt;/b&gt;&lt;br&gt;&lt;b&gt;Vec3&lt;/b&gt; vector arithmetic (including cross / dot products)&lt;br&gt;&lt;b&gt;Face&lt;/b&gt; triangle referencing three Vec3 vertices&lt;br&gt;Shared geometry types used by Shape, Transformation and Rasterizer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="700" y="790" width="400" height="155" as="geometry" />
